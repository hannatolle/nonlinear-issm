{
  "seed": 0,
  "output_dir": "outputs/realdata/huang/nonlinear",
  "verbose": true,
  "experiment": "TrainHuangISSM",
  "job_id": 0,
  "device": "auto",
  "logging": {
    "logger": "local",
    "params": {}
  },
  "settings": {
    "save_weights": true,
    "debug": false,
    "preproc_dir": "data/huang_2023/preproc",
    "subject": "sub-2",
    "drop_bad": true,
    "require_location": true,
    "drop_white_matter": true,
    "drop_artefact_trials": true,
    "drop_residual_artefact_trials": true,
    "resample_hz": 256,
    "t_start_ms": -50,
    "t_end_ms": 200,
    "normalize_u": true,
    "dt": 0.00390625,
    "discrete": false,
    "interventional": true,
    "B_threshold": 0.001,
    "x_init_sigma": 0.05,
    "y_init_sigma": 0.1,
    "min_logstd": -5.0,
    "max_logstd": 5.0,
    "standardize": true,
    "batch_size": 32,
    "n_val_samples": 10,
    "n_test_samples": 30,
    "ood_test_channels": "RC3-RC4",
    "n_epochs": 3000,
    "lr": 0.003,
    "weight_decay": 0.01,
    "grad_clip": 1.0,
    "beta": 1.0,
    "beta_schedule": "linear",
    "beta_warmup_fraction": 0.25,
    "tau_warmup_fraction": 0.0,
    "early_stopping": true,
    "es_patience": 100,
    "es_metric": "val_y_mae_rollout",
    "es_min_delta": 0.0,
    "D": [15, 20, 25, 30],
    "N": 99,
    "M": 50
  },
  "components": {
    "dynamics": {
      "kind": "AnalyticMLPDynamics",
      "params": {
        "train_leak": false,
        "train_B": true,
        "B_init": "none",
        "B_init_scale": 0.1,
        "sparsity": 0.0,
        "B_prior": "none",
        "diagonal_cov": true,
        "max_tau_B": 0.0,
        "hidden_dim": 64,
        "num_hidden_layers": 3,
        "activation": "gelu",
        "init_scale": null
      }
    },
    "emission": {
      "kind": "ResMLPEmission",
      "params": {
        "H": 128,
        "n_blocks": 3,
        "p_dropout": 0.1
      }
    },
    "likelihood": {
      "kind": "NormalConditionalLikelihood",
      "params": {}
    },
    "recognition": {
      "kind": "SharedLSTM",
      "params": {
        "H": 64,
        "bidirectional": true,
        "input_dropout": 0.2,
        "obs_mask_prob": 0.1
      }
    },
    "b_net": {
      "kind": "SiteEmbeddingB",
      "params": {
        "hidden_dim": 32,
        "n_layers": 2,
        "activation": "gelu"
      }
    }
  }
}